      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nskinparam shadowing false\nskinparam backgroundColor white\nskinparam defaultFontName Arial\nskinparam defaultFontSize 13\nskinparam sequenceMessageAlign center\nskinparam responseMessageBelowArrow true\n\ntitle Media Playback - UML Sequence Diagram\n\nactor User\nparticipant \&quot;MpvPlayerForm\&quot; as Form\nparticipant \&quot;Playlist\\n(ListBox)\&quot; as Playlist\nparticipant \&quot;libmpv\&quot; as MPV\nparticipant \&quot;Video Panel\&quot; as Panel\n\n== Select Media ==\n\nUser -&gt; Playlist : Double-click media item\nPlaylist -&gt; Form : lstPlaylist_DoubleClick()\nForm -&gt; Playlist : Get selected index\nPlaylist --&gt; Form : Selected index\n\nForm -&gt; Form : PlayIndex(index)\nForm -&gt; Form : PlayFile(path)\n\n== Load and Play ==\n\nForm -&gt; MPV : mpv_command(loadfile)\nactivate MPV\n\nMPV -&gt; MPV : Load and decode media\n\nalt Media loaded successfully\n    MPV -&gt; Panel : Render video frames\n    MPV --&gt; Form : Playback state and events\n    Form -&gt; Playlist : Update current selection\n    Form --&gt; User : Show playback state\nelse Loading failed\n    MPV --&gt; Form : Error or failure event\n    Form --&gt; User : Handle playback error\nend\n\n== Playback Controls ==\n\nopt Play or Pause\n    User -&gt; Form : Click Pause or press Space\n    Form -&gt; MPV : Update pause property\n    MPV --&gt; Form : Updated playback state\n    Form --&gt; User : Update Play/Pause button\nend\n\nopt Seek\n    User -&gt; Form : Seek using slider or arrow key\n    Form -&gt; MPV : Set playback position\n    MPV --&gt; Form : Updated time position\n    Form --&gt; User : Update progress slider\nend\n\nopt Change Volume\n    User -&gt; Form : Adjust volume\n    Form -&gt; MPV : Set volume property\n    MPV --&gt; Form : Updated volume state\nend\n\nopt Stop\n    User -&gt; Form : Click Stop\n    Form -&gt; MPV : Stop playback\n    MPV --&gt; Form : Playback stopped\n    Form --&gt; User : Update controls\nend\n\ndeactivate MPV\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="HFZOZQaMhzh5KYQwajxQ-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
