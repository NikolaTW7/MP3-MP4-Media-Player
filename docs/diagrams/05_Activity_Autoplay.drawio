        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nskinparam shadowing false\nskinparam backgroundColor white\nskinparam defaultFontName Arial\nskinparam defaultFontSize 14\nskinparam activityBorderColor #444444\nskinparam activityBackgroundColor #F5F5F5\nskinparam arrowColor #444444\n\ntitle Autoplay, Repeat and Shuffle - UML Activity Diagram\n\nstart\n\n:Current media reaches end;\n:Receive end-of-file event from libmpv;\n:Check playlist and playback settings;\n\nif (Playlist empty?) then (Yes)\n  :Stop automatic playback;\nelse (No)\n\n  if (Repeat One enabled?) then (Yes)\n    :Replay current media;\n  else (No)\n\n    if (Shuffle enabled?) then (Yes)\n      :Check shuffle order;\n\n      if (Another item in shuffle order?) then (Yes)\n        :Select next shuffled item;\n      else (No)\n        if (Repeat All enabled?) then (Yes)\n          :Start new shuffle cycle;\n          :Select first shuffled item;\n        else (No)\n          :Stop automatic playback;\n          stop\n        endif\n      endif\n\n    else (No)\n      if (Another item in playlist?) then (Yes)\n        :Select next playlist item;\n      else (No)\n        if (Repeat All enabled?) then (Yes)\n          :Select first playlist item;\n        else (No)\n          :Stop automatic playback;\n          stop\n        endif\n      endif\n    endif\n\n    :Update current playlist selection;\n  endif\n\n  :Load selected media using libmpv;\n  :Start playback;\n\nendif\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="JRNpZTp2g9NIkqoB8AXJ-1">
