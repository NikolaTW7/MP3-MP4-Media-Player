        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nskinparam shadowing false\nskinparam backgroundColor white\nskinparam defaultFontName Arial\nskinparam defaultFontSize 14\nskinparam activityBorderColor #444444\nskinparam activityBackgroundColor #F5F5F5\nskinparam arrowColor #444444\n\ntitle Media Playback - UML Activity Diagram\n\nstart\n\n:Open MP3/MP4 Media Player;\n\nif (Playlist empty?) then (Yes)\n  :Click Add Files;\n  :Select local media files;\n  :Add files to playlist;\nendif\n\n:Select a media file;\n:Load file using libmpv;\n\nif (File loaded successfully?) then (Yes)\n\n  :Start playback;\n\n  while (Playback session active?) is (Yes)\n\n    :Wait for playback event or user action;\n\n    if (Stop requested?) then (Yes)\n      :Stop playback;\n      break\n\n    elseif (Media reached end?) then (Yes)\n      :Finish current playback;\n      break\n\n    elseif (Pause requested?) then (Yes)\n      :Pause playback;\n\n    elseif (Resume requested?) then (Yes)\n      :Resume playback;\n\n    elseif (Seek requested?) then (Yes)\n      :Update playback position;\n\n    elseif (Volume changed?) then (Yes)\n      :Update volume;\n\n    endif\n\n  endwhile (No)\n\nelse (No)\n  :Handle loading error;\nendif\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="0o24_nAY0LWtevAMsX9p-138">
