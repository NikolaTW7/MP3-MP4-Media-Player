        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nskinparam shadowing false\nskinparam backgroundColor white\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nskinparam nodesep 45\nskinparam ranksep 55\n\ntitle MP3/MP4 Media Player - UML Class Diagram\n\nnamespace MyMediaPlayer {\n\n  class MpvPlayerForm {\n    - mpv : mpv_handle*\n    - currentIndex : int\n    - repeatMode : RepeatMode\n    - isShuffle : bool\n    - shuffleOrder : List&lt;int&gt;\n    - shufflePos : int\n    - isFullScreen : bool\n    - fsOverlay : FullscreenOverlay\n    --\n    + MpvPlayerForm()\n    # HandleShortcut(Keys) : bool\n    - InitializeMpv() : void\n    - PlayIndex(int) : void\n    - PlayFile(String) : void\n    - SeekToPercent(double) : void\n    - ProcessMpvEvents() : void\n    - AdvanceAfterEnd(bool) : void\n    - BuildShuffleOrder(int) : void\n    - StartNewShuffleCycle() : void\n    - EnterFullScreen() : void\n    - ExitFullScreen() : void\n    - OpenOverlay() : void\n    - CloseOverlay() : void\n    - SyncOverlay() : void\n  }\n\n  enum RepeatMode {\n    Off\n    All\n    One\n  }\n\n  class MediaItem {\n    + FullPath : String\n    + FileName : String\n    --\n    + MediaItem(String)\n    + ToString() : String\n  }\n\n  class FullscreenOverlay {\n    + seekBar : SeekBar\n    + volumeBar : SeekBar\n    + lblTime : Label\n    + ShortcutHandler : Func&lt;Keys, bool&gt;\n    - pressed : bool\n    --\n    + FullscreenOverlay()\n    + TrackPress(Control) : void\n    + SetToggle(Button, String, bool) : void\n    + IsPressed : bool\n  }\n\n  class \&quot;FullscreenOverlay::SeekBar\&quot; as SeekBar {\n    + FillColor : Color\n    + SnapToEnds : bool\n    - value : double\n    - dragging : bool\n    --\n    + Value : double\n    + IsDragging : bool\n    + OnMouseDown(MouseEventArgs) : void\n    + OnMouseMove(MouseEventArgs) : void\n    + OnMouseUp(MouseEventArgs) : void\n    + OnPaint(PaintEventArgs) : void\n  }\n\n  class \&quot;FullscreenOverlay::NoFocusButton\&quot; as NoFocusButton {\n    + NoFocusButton()\n  }\n}\n\nclass \&quot;Windows Forms Form\&quot; as Form &lt;&lt;external&gt;&gt;\nclass \&quot;Windows Forms Control\&quot; as Control &lt;&lt;external&gt;&gt;\nclass \&quot;Windows Forms Button\&quot; as Button &lt;&lt;external&gt;&gt;\nclass \&quot;libmpv C API\&quot; as Libmpv &lt;&lt;external&gt;&gt;\n\nForm &lt;|-- MyMediaPlayer.MpvPlayerForm\nForm &lt;|-- MyMediaPlayer.FullscreenOverlay\nControl &lt;|-- SeekBar\nButton &lt;|-- NoFocusButton\n\nMyMediaPlayer.MpvPlayerForm *-- \&quot;0..1\&quot; MyMediaPlayer.FullscreenOverlay\nMyMediaPlayer.MpvPlayerForm o-- \&quot;0..*\&quot; MyMediaPlayer.MediaItem\nMyMediaPlayer.MpvPlayerForm ..&gt; MyMediaPlayer.RepeatMode\nMyMediaPlayer.MpvPlayerForm ..&gt; Libmpv : playback commands\nMyMediaPlayer.FullscreenOverlay *-- \&quot;2\&quot; SeekBar\nMyMediaPlayer.FullscreenOverlay *-- \&quot;9\&quot; NoFocusButton\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="RxiHcc2WyTkBspPF555N-1">
